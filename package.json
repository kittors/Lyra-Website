    "test": "node --test \"test/**/*.test.ts\"",
    "deploy": "astro build && wrangler deploy",
    "capture": "node scripts/capture/capture.ts"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.4",
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "hono": "4.13.9",
    "lenis": "1.3.26",
    "sharp": "0.35.4",
    "simple-icons": "16.32.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "^24.13.6",
    "typescript": "6.0.3",
    "wrangler": "4.141.0"
  }
