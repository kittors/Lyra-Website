{
  "name": "lyra-website",
  "private": true,
  "type": "module",
  "description": "lyra.07230805.xyz — the Lyra website, its downloads and its documentation.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "astro dev",
