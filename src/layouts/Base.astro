---
import "../styles/tokens.css";
import "../styles/shared.css";
import "../styles/site.css";

import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { localize, type Locale } from "../i18n/index.ts";
import { SITE_TEXT } from "../i18n/site.ts";
import { ARRIVAL_SCRIPT, VIEW_TRANSITION_OPT_IN } from "../scripts/arrival.ts";

/**
 * Every product page: the head, the navigation, the footer, and the scripts that must run before
 * the first frame — the theme, the failsafe that shows the page if the motion script never does,
 * and whether the reader arrived from another page of the site (`scripts/arrival.ts`).
 */
interface Props {
	locale: Locale;
	/** The page's path without its locale prefix: `/`, `/download/`. Null for a page with no twin. */
	route: string | null;
	title: string;
	description: string;
	/** The release notes link for the footer. */
	notesUrl: string;
	/** Just the page, under a bare wordmark: no navigation, no footer (the 404). */
	bare?: boolean;
}

const { locale, route, title, description, notesUrl, bare = false } = Astro.props;
const text = SITE_TEXT[locale];
const site = Astro.site ?? new URL("https://lyra.07230805.xyz");
const canonical = route ? new URL(localize(locale, route), site).href : null;
const og = new URL("/og.png", site).href;
---

<!doctype html>
<html lang={locale} data-theme="light" data-site="product">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<style is:inline set:html={VIEW_TRANSITION_OPT_IN} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{canonical && <link rel="canonical" href={canonical} />}
		{
			route && (
				<>
					<link rel="alternate" hreflang="zh-CN" href={new URL(localize("zh-CN", route), site).href} />
					<link rel="alternate" hreflang="en" href={new URL(localize("en", route), site).href} />
					<link rel="alternate" hreflang="x-default" href={new URL(localize("zh-CN", route), site).href} />
				</>
			)
		}
		<link rel="icon" href="/favicon.png" type="image/png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Lyra" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={og} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={locale === "en" ? "en_US" : "zh_CN"} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="generator" content={Astro.generator} />

		{/*
			Before the first frame: the theme (the docs' choice if the reader made one, else the
			system's), and `js`, which lets the stylesheet hide what the motion script brings in.
			If that script has not said it is running a second and a half later — blocked, broken, a
			slow phone, a slow link from mainland China to the edge — `motion-failed` puts everything
			back where it would be without it. Short on purpose: an entrance nobody sees is no loss,
			and a blank page while it waits is the worst first impression the site can make.
		*/}
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let stored = null;
				try {
					stored = localStorage.getItem("starlight-theme");
				} catch {}
				const dark = stored === "dark" || (stored !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
				root.dataset.theme = dark ? "dark" : "light";
				root.classList.add("js");
				setTimeout(() => {
					if (!root.classList.contains("motion-ready")) root.classList.add("motion-failed");
				}, 1500);
			})();
		</script>
		<script is:inline set:html={ARRIVAL_SCRIPT} />
		<slot name="head" />
	</head>
	<body>
		{!bare && <a class="skip-link" href="#main">{text.skip}</a>}
		{bare ? <slot name="header" /> : <Nav locale={locale} route={route} />}
		<main id="main" tabindex="-1">
			<slot />
		</main>
		{!bare && <Footer locale={locale} route={route} notesUrl={notesUrl} />}
		<script>
			import "../scripts/site.ts";
		</script>
	</body>
</html>

<style>
	main {
		display: block;
		outline: none;
	}
</style>
