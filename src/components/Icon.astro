---
/**
 * The site's own interface glyphs — download, copy, check, chevron and the like. Drawn on a 24-unit
 * grid with a 1.75 stroke and round joins, so they sit with SF Symbols and with the platform marks.
 */
export type IconName =
	| "download"
	| "copy"
	| "check"
	| "chevron-down"
	| "arrow-up-right"
	| "globe"
	| "wifi"
	| "link"
	| "relay"
	| "sparkle"
	| "phone"
	| "sun"
	| "moon"
	| "display";

interface Props {
	name: IconName;
	size?: string;
	class?: string;
	label?: string;
	[key: `data-${string}`]: string | boolean | undefined;
}

const { name, size = "1em", class: className, label, ...rest } = Astro.props;

const PATHS: Record<IconName, string> = {
	download: "M12 4v11m0 0 4.5-4.5M12 15l-4.5-4.5M5 19.5h14",
	copy: "M9 9.5A1.5 1.5 0 0 1 10.5 8h7A1.5 1.5 0 0 1 19 9.5v9a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 9 18.5zM15 8V5.5A1.5 1.5 0 0 0 13.5 4h-7A1.5 1.5 0 0 0 5 5.5v9A1.5 1.5 0 0 0 6.5 16H9",
	check: "m5 12.5 4.5 4.5L19 7.5",
	"chevron-down": "m6 9.5 6 6 6-6",
	"arrow-up-right": "M8 16 16.5 7.5M9 7.5h7.5V15",
	globe: "M12 20.5a8.5 8.5 0 1 0 0-17 8.5 8.5 0 0 0 0 17Zm0 0c2.2-2.2 3.3-5 3.3-8.5S14.2 5.7 12 3.5M12 20.5c-2.2-2.2-3.3-5-3.3-8.5S9.8 5.7 12 3.5M3.8 9.5h16.4M3.8 14.5h16.4",
	wifi: "M4 9.5a11.5 11.5 0 0 1 16 0M6.8 12.6a7.5 7.5 0 0 1 10.4 0M9.6 15.7a3.5 3.5 0 0 1 4.8 0M12 19h.01",
	link: "M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1",
	relay: "M5 12a2 2 0 1 0 0-.01M19 12a2 2 0 1 0 0-.01M12 6a2 2 0 1 0 0-.01M6.7 10.6 10.3 7.4m3.4 0 3.6 3.2M7 12h10",
	sparkle: "M12 3.5c.6 4.4 2.1 5.9 6.5 6.5-4.4.6-5.9 2.1-6.5 6.5-.6-4.4-2.1-5.9-6.5-6.5 4.4-.6 5.9-2.1 6.5-6.5ZM18.5 15.5c.3 1.9.9 2.5 2.5 2.8-1.6.3-2.2.9-2.5 2.7-.3-1.8-.9-2.4-2.5-2.7 1.6-.3 2.2-.9 2.5-2.8Z",
	sun: "M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM12 2.75v1.75m0 15v1.75M5.46 5.46l1.24 1.24m10.6 10.6 1.24 1.24M2.75 12H4.5m15 0h1.75M5.46 18.54l1.24-1.24m10.6-10.6 1.24-1.24",
	moon: "M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z",
	display: "M4.5 5h15a1 1 0 0 1 1 1v9.5a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm4.5 14.5h6M12 16.5v3",
	phone: "M8.5 3h7A1.5 1.5 0 0 1 17 4.5v15a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 19.5v-15A1.5 1.5 0 0 1 8.5 3Zm2.5 15h2",
};

const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<svg
	class:list={["icon", className]}
	viewBox="0 0 24 24"
	width={size}
	height={size}
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	focusable="false"
	{...a11y}
	{...rest}
>
	<path d={PATHS[name]} />
</svg>

<style>
	.icon {
		flex: none;
		display: inline-block;
		vertical-align: -0.125em;
	}
</style>
