---
import Dropdown from "../Dropdown.astro";

/**
 * Starlight's language picker, as the site's own dropdown. Choosing a language goes to this same page
 * in it: the site's rule is that English lives under `/en/` and Chinese at the root.
 */
const en = Astro.locals.starlightRoute.lang === "en";
const path = Astro.url.pathname;
const chinesePath = en ? path.replace(/^\/en(?=\/|$)/, "") || "/" : path;
const englishPath = en ? path : `/en${path}`;
---

<Dropdown
	kind="link"
	label={en ? "Language" : "语言"}
	showLabel
	icon="globe"
	class="docs-dropdown"
	options={[
		{ value: "zh-CN", label: "简体中文", href: chinesePath, lang: "zh-CN", selected: !en },
		{ value: "en", label: "English", href: englishPath, lang: "en", selected: en },
	]}
/>
