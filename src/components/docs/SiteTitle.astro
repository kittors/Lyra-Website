---
import { Image } from "astro:assets";

import appIcon from "../../assets/brand/app-icon.png";

/**
 * Starlight's site title, drawn like the product pages' wordmark: the icon's tile cropped out of its
 * transparent margin, "Lyra", and the section name beside it. It links to the home page in the
 * reader's language, as Starlight's own does.
 */
const { siteTitleHref } = Astro.locals.starlightRoute;
const en = Astro.locals.starlightRoute.lang === "en";
---

<a href={siteTitleHref} class="docs-title">
	<span class="docs-logo" aria-hidden="true">
		<Image src={appIcon} alt="" width={36} densities={[1, 2, 3]} loading="eager" />
	</span>
	<span class="docs-name" translate="no">Lyra</span>
	<span class="docs-section">{en ? "Docs" : "文档"}</span>
</a>

<style>
	.docs-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
		color: var(--sl-color-white);
		text-decoration: none;
		white-space: nowrap;
	}
	.docs-logo {
		display: block;
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
		overflow: hidden;
		border-radius: 22.5%;
	}
	.docs-logo :global(img) {
		width: calc(1.75rem * 1024 / 824);
		max-width: none;
		height: calc(1.75rem * 1024 / 824);
		margin: calc(1.75rem * -100 / 824);
	}
	.docs-name {
		font-size: 1.0625rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.docs-section {
		padding-left: 0.5rem;
		border-left: 0.5px solid var(--sl-color-hairline-light);
		color: var(--sl-color-gray-3);
		font-size: 1rem;
		font-weight: 500;
	}
</style>
