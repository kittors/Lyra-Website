---
import { Image } from "astro:assets";

import { MARKET_ICONS } from "../../lib/market.ts";

/**
 * Three rows of the market's logos drifting sideways, the middle row the other way.
 *
 * Every row carries all thirty logos, each in its own order — the list itself, then two strides
 * through it that share no factor with its length — so no logo is on screen twice and no two rows
 * run the same sequence side by side. A row's track holds its thirty twice and moves by exactly
 * thirty per loop, so the seam never shows; thirty tiles are wider than a 1920-pixel screen, so the
 * right edge never runs dry.
 *
 * The motion is CSS (a transform, on the compositor) and pauses under the pointer. With reduced
 * motion the wall is one still, wrapped set. Only the first row's first set is read out.
 */
interface Props {
	label: string;
}

const { label } = Astro.props;
const count = MARKET_ICONS.length;
const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
/** The first stride at or above `from` that visits every logo exactly once. */
const strideFrom = (from: number) => {
	let stride = from;
	while (count > 1 && gcd(stride, count) !== 1) stride++;
	return stride;
};
const orders = [
	{ start: 0, stride: 1 },
	{ start: Math.floor(count / 2), stride: strideFrom(7) },
	{ start: Math.floor(count / 4), stride: strideFrom(11) },
];
const rows = orders.map(({ start, stride }) => Array.from({ length: count }, (_, i) => MARKET_ICONS[(start + i * stride) % count]!));
const durations = ["120s", "140s", "108s"];
---

<div class="wall" role="group" aria-label={label} data-logo-wall>
	{
		rows.map((icons, row) => {
			return (
				<div class:list={["wall-row", { "wall-row--reverse": row === 1, "wall-row--extra": row > 0 }]} style={`--duration: ${durations[row]}`} aria-hidden={row > 0 ? "true" : undefined}>
					<ul class="wall-track">
						{[0, 1].map((copy) =>
							icons.map((icon) => {
								const first = row === 0 && copy === 0;
								return (
									<li
										class:list={["tile", { "tile--filled": icon.filled, "tile--repeat": !first }]}
										style={icon.brandColor ? `--brand: ${icon.brandColor}` : undefined}
										aria-hidden={first ? undefined : "true"}
									>
										<span class="tile-face">
											<Image
												src={icon.image}
												alt={first ? icon.name : ""}
												width={icon.filled ? 88 : 52}
												height={icon.filled ? 88 : 52}
												densities={[1, 2]}
												loading="lazy"
												decoding="async"
											/>
										</span>
									</li>
								);
							}),
						)}
					</ul>
				</div>
			);
		})
	}
</div>

<style>
	.wall {
		--tile: clamp(4.25rem, 3.5rem + 2vw, 5.5rem);
		--gap: clamp(0.875rem, 0.6rem + 0.8vw, 1.25rem);
		display: grid;
		gap: var(--gap);
		/* Rows fade out at both edges instead of being cut off. */
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}
	/* Room above and below for a lifted tile's glow, given back so rows keep their spacing. */
	.wall-row {
		display: flex;
		overflow: hidden;
		padding-block: 1.25rem;
		margin-block: -1.25rem;
	}
	.wall-track {
		display: flex;
		flex: none;
		gap: var(--gap);
		padding-right: var(--gap);
		animation: drift var(--duration) linear infinite;
	}
	.wall-row--reverse .wall-track {
		animation-direction: reverse;
	}
	.wall:hover .wall-track {
		animation-play-state: paused;
	}
	@keyframes drift {
		to {
			transform: translate3d(-50%, 0, 0);
		}
	}

	.tile {
		position: relative;
		flex: none;
		width: var(--tile);
		height: var(--tile);
		transition: transform var(--dur-base) var(--ease-out);
	}
	/* The brand's own colour, glowing behind a tile under the pointer. */
	.tile::before {
		content: "";
		position: absolute;
		inset: -28%;
		border-radius: 50%;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--brand, #0a6cf5) 42%, transparent), transparent);
		opacity: 0;
		transition: opacity var(--dur-slow) var(--ease-soft);
		pointer-events: none;
	}
	.tile:hover {
		transform: translateY(-3px) scale(1.05);
	}
	.tile:hover::before {
		opacity: 1;
	}
	.tile-face {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: 24%;
		background: #fff;
		box-shadow:
			0 0 0 0.5px rgb(0 0 0 / 0.08),
			0 1px 2px rgb(0 0 0 / 0.04),
			0 6px 16px -6px rgb(16 24 40 / 0.16);
	}
	.tile-face :global(img) {
		width: 58%;
		height: 58%;
		object-fit: contain;
	}
	.tile--filled .tile-face :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	:global(:root[data-theme="dark"]) .tile-face {
		box-shadow:
			0 0 0 0.5px rgb(255 255 255 / 0.12),
			0 8px 20px -8px rgb(0 0 0 / 0.8);
	}

	@media (prefers-reduced-motion: reduce) {
		.wall {
			-webkit-mask-image: none;
			mask-image: none;
		}
		/* Thirty logos, still: ten to a row, three rows. */
		.wall-track {
			flex: 1;
			flex-wrap: wrap;
			justify-content: center;
			max-width: calc(10 * var(--tile) + 9 * var(--gap));
			margin-inline: auto;
			padding-right: 0;
			animation: none;
		}
		.tile--repeat,
		.wall-row--extra {
			display: none;
		}
	}
</style>
