---
import { Image } from "astro:assets";

import appIcon from "../../assets/brand/app-icon.png";
import { HOME_TEXT } from "../../i18n/home.ts";
import type { Locale } from "../../i18n/index.ts";
import Phrases from "../Phrases.astro";
import SectionHead from "../SectionHead.astro";
import SplitHeading from "../SplitHeading.astro";
import WindowFrame from "../WindowFrame.astro";

/**
 * The workspace, told in three steps while the window stays put: the page holds still (a sticky
 * stage, not a scroll hijack) and each step brings its own screenshot forward. The third step is
 * the scheduled task, and a finished-task notification slides in over it — both real features.
 *
 * Two layouts, one chosen by CSS: the pinned stage on a wide screen with motion allowed, and a
 * plain stack of step-and-picture everywhere else. The hidden one's pictures are lazy and never
 * load.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = HOME_TEXT[locale].workspace;
const scenes = t.steps.map((step) => step.scene);
const alts = t.steps.map((step) => step.alt);
---

<section class="workspace" aria-labelledby="workspace-title">
	<div class="ws-pinned" data-ws-pinned style={`--steps: ${t.steps.length}`}>
		<div class="ws-sticky">
			<div class="container ws-grid">
				<div class="ws-copy">
					<p class="t-eyebrow" data-reveal>{t.eyebrow}</p>
					<SplitHeading as="h2" text={t.title} id="workspace-title" class="t-title ws-title" />
					<div class="ws-list">
						<span class="ws-rail" aria-hidden="true"><span class="ws-rail-fill" data-ws-progress></span></span>
						<ol class="ws-steps">
							{
								t.steps.map((step, index) => (
									<li class:list={["ws-step", { "is-active": index === 0 }]} data-ws-step={index} data-reveal>
										<h3>{step.title}</h3>
										<p><Phrases text={step.body} /></p>
									</li>
								))
							}
						</ol>
					</div>
				</div>
				<div class="ws-visual" data-reveal data-ws-visual>
					<WindowFrame scene={scenes} alt={alts} locale={locale} sizes="(min-width: 80rem) 50rem, 62vw" data-ws-window />
					<div class="ws-notice" aria-hidden="true" data-ws-notice>
						<Image src={appIcon} alt="" width={40} densities={[1, 2]} loading="lazy" class="ws-notice-icon" />
						<div class="ws-notice-text">
							<p class="ws-notice-head">
								<span class="ws-notice-title">{t.notice.app}</span>
								<span class="ws-notice-time">{t.notice.time}</span>
							</p>
							<p class="ws-notice-body">{t.notice.body}</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="ws-stack section">
		<div class="container">
			<SectionHead eyebrow={t.eyebrow} title={t.title} size="title" />
			<ol class="ws-stack-steps">
				{
					t.steps.map((step) => (
						<li>
							<div class="ws-stack-text" data-reveal>
								<h3 class="t-headline">{step.title}</h3>
								<p class="t-body"><Phrases text={step.body} /></p>
							</div>
							<div data-rise>
								<WindowFrame scene={step.scene} alt={step.alt} locale={locale} sizes="(min-width: 64rem) 60rem, 94vw" />
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</div>
</section>

<style>
	/* ── Pinned ── */
	.ws-pinned {
		position: relative;
		height: calc(100svh + var(--steps) * 80svh);
	}
	.ws-sticky {
		position: sticky;
		top: 0;
		display: flex;
		align-items: center;
		height: 100svh;
		padding-top: var(--nav-height);
		overflow: clip;
	}
	.ws-grid {
		display: grid;
		grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
		align-items: center;
		gap: clamp(2.5rem, 1rem + 4vw, 5.5rem);
	}
	.ws-title {
		margin-top: 0.75rem;
	}
	.ws-list {
		position: relative;
		margin-top: clamp(2rem, 1.5rem + 2vh, 3rem);
		padding-left: 1.5rem;
	}
	.ws-rail {
		position: absolute;
		left: 0;
		top: 0.25rem;
		bottom: 0.25rem;
		width: 2px;
		border-radius: 1px;
		background: var(--line-strong);
		overflow: hidden;
	}
	.ws-rail-fill {
		position: absolute;
		inset: 0;
		background: var(--lyra-blue);
		transform: scaleY(0);
		transform-origin: 50% 0;
	}
	.ws-step + .ws-step {
		margin-top: 1.5rem;
	}
	.ws-step h3 {
		font-size: var(--t-headline);
		font-weight: var(--weight-bold);
		line-height: 1.3;
		letter-spacing: var(--ls-title);
	}
	.ws-step p {
		margin-top: 0.375rem;
		max-width: 24rem;
		color: var(--ink-2);
		font-size: 1rem;
		line-height: 1.55;
		text-wrap: pretty;
	}
	/* Dimmed, not collapsed: nothing changes height as the steps change. */
	.ws-step h3,
	.ws-step p {
		opacity: 0.32;
		transition: opacity var(--dur-slow) var(--ease-soft);
	}
	.ws-step.is-active h3,
	.ws-step.is-active p {
		opacity: 1;
	}

	.ws-visual {
		position: relative;
	}
	/* WindowFrame stacks the later shots on the first. The script names the step in `data-active`;
	 * that shot cross-fades in and settles from a touch larger, which reads as the window coming
	 * forward. Without the script, the first shot simply stays. */
	.ws-visual :global([data-shot]) {
		transition:
			opacity 0.7s var(--ease-soft),
			transform 1.1s var(--ease-out);
	}
	.ws-visual[data-active] :global([data-shot]) {
		opacity: 0;
		transform: scale(1.03);
	}
	.ws-visual[data-active="0"] :global([data-shot="0"]),
	.ws-visual[data-active="1"] :global([data-shot="1"]),
	.ws-visual[data-active="2"] :global([data-shot="2"]) {
		opacity: 1;
		transform: none;
	}

	/* A macOS notification: top right of the window, frosted, sliding in from the edge. */
	.ws-notice {
		position: absolute;
		top: 5%;
		right: 3%;
		z-index: 5;
		display: flex;
		align-items: center;
		gap: 0.625rem;
		width: min(19rem, 44%);
		padding: 0.75rem 0.875rem;
		border-radius: 1.125rem;
		background: color-mix(in srgb, var(--surface-raised) 78%, transparent);
		box-shadow: var(--shadow-float);
		-webkit-backdrop-filter: saturate(180%) blur(24px);
		backdrop-filter: saturate(180%) blur(24px);
		font-size: 0.8125rem;
		line-height: 1.35;
		opacity: 0;
		transform: translate3d(1.5rem, 0, 0);
		transition:
			opacity 0.45s var(--ease-soft),
			transform 0.6s var(--ease-out);
	}
	.ws-visual[data-active="2"] .ws-notice {
		opacity: 1;
		transform: none;
		transition-delay: 0.35s;
	}
	.ws-notice :global(.ws-notice-icon) {
		flex: none;
		width: 2.4rem;
		height: 2.4rem;
		margin: -0.25rem -0.2rem -0.25rem -0.25rem;
	}
	.ws-notice-text {
		min-width: 0;
		flex: 1;
	}
	.ws-notice-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.ws-notice-title {
		font-weight: var(--weight-bold);
		color: var(--ink);
	}
	.ws-notice-time {
		color: var(--ink-3);
		font-size: 0.75rem;
	}
	.ws-notice-body {
		margin-top: 0.125rem;
		color: var(--ink);
	}

	/* ── Stacked ── */
	.ws-stack-steps {
		margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
	}
	.ws-stack-steps > li + li {
		margin-top: clamp(4rem, 3rem + 4vw, 6rem);
	}
	.ws-stack-text {
		max-width: 36rem;
		margin: 0 auto 1.75rem;
		text-align: center;
	}
	.ws-stack-text p {
		margin-top: 0.5rem;
	}

	/* Which layout: pinned only where there is room for it and motion is welcome. */
	.ws-stack {
		display: none;
	}
	@media (max-width: 64rem), (max-height: 34rem), (prefers-reduced-motion: reduce) {
		.ws-pinned {
			display: none;
		}
		.ws-stack {
			display: block;
		}
	}
</style>
