---
import { HOME_TEXT } from "../../i18n/home.ts";
import type { Locale } from "../../i18n/index.ts";
import SectionHead from "../SectionHead.astro";
import WindowFrame from "../WindowFrame.astro";

/**
 * Several conversations in one window (up to four). The screenshot starts close on the first
 * conversation and pulls back as the reader scrolls until the whole window is in view (`home.ts`).
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = HOME_TEXT[locale].split;
---

<section class="section split" aria-labelledby="split-title">
	<div class="container">
		<SectionHead eyebrow={t.eyebrow} title={t.title} lead={t.lead} id="split-title" />
	</div>
	<div class="split-stage" data-split-stage>
		<WindowFrame scene="split-view" locale={locale} alt={t.shotAlt} moving sizes="(min-width: 68rem) 62.5rem, 94vw" data-split-window />
	</div>
</section>

<style>
	.split-stage {
		width: min(100% - 2 * var(--gutter), var(--shot-max));
		margin: clamp(3rem, 2rem + 3vw, 5rem) auto 0;
	}
</style>
