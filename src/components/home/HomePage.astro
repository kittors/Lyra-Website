---
import { type Locale } from "../../i18n/index.ts";
import { SITE_TEXT } from "../../i18n/site.ts";
import Base from "../../layouts/Base.astro";
import { getRelease } from "../../lib/release.ts";
import Bento from "./Bento.astro";
import Cta from "./Cta.astro";
import Hero from "./Hero.astro";
import Kernel from "./Kernel.astro";
import Market from "./Market.astro";
import Mobile from "./Mobile.astro";
import OpenSource from "./OpenSource.astro";
import SplitView from "./SplitView.astro";
import SubAgents from "./SubAgents.astro";
import Workspace from "./Workspace.astro";

/**
 * The home page, in either language. The sections alternate light and dark on purpose — the dark
 * ones are the claims that most set Lyra apart — and each moves in its own way (`scripts/home.ts`).
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const meta = SITE_TEXT[locale].meta.home;
const release = await getRelease();
---

<Base locale={locale} route="/" title={meta.title} description={meta.description} notesUrl={release.notesUrl}>
	<Hero locale={locale} release={release} />
	<Kernel locale={locale} />
	<SplitView locale={locale} />
	<SubAgents locale={locale} />
	<Market locale={locale} />
	<Workspace locale={locale} />
	<Mobile locale={locale} />
	<OpenSource locale={locale} />
	<Bento locale={locale} />
	<Cta locale={locale} />
</Base>

<script>
	import "../../scripts/home.ts";
</script>
