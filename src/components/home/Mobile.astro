---
import { HOME_TEXT } from "../../i18n/home.ts";
import type { Locale } from "../../i18n/index.ts";
import { mobileShots } from "../../lib/shots.ts";
import Icon, { type IconName } from "../Icon.astro";
import PhoneFrame from "../PhoneFrame.astro";
import Phrases from "../Phrases.astro";
import SectionHead from "../SectionHead.astro";
import WindowFrame from "../WindowFrame.astro";

/**
 * The phone, on black: the desktop's window and the phone showing the same session, the phone a
 * step nearer and moving a little faster as the page scrolls. With phone screenshots it shows them;
 * without, the mascot stands in.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = HOME_TEXT[locale].mobile;
/**
 * In the captures' order: a command waiting for approval (1), the session list with that conversation
 * held down — lifted over the blurred page, its menu open (2), a new conversation's empty screen (3).
 */
const phones = mobileShots("dark", locale);
const [approval, list, start] = phones;
---

<section class="section surface-night mobile" aria-labelledby="mobile-title" data-night>
	<div class="mobile-glow" aria-hidden="true"></div>
	<div class="container">
		<SectionHead eyebrow={t.eyebrow} title={t.title} lead={t.lead} id="mobile-title" />
	</div>
	{
		phones.length >= 3 ? (
			<div class="container mobile-trio">
				<div class="trio-side trio-side--left" data-parallax="0.1">
					<PhoneFrame image={list} alt={t.listAlt} synced={t.synced} sizes="(min-width: 48rem) 14.375rem, 42vw" />
				</div>
				<div class="trio-center" data-rise="solid">
					<PhoneFrame image={approval} alt={t.approvalAlt} synced={t.synced} sizes="(min-width: 48rem) 16.75rem, 56vw" />
				</div>
				<div class="trio-side trio-side--right" data-parallax="0.1">
					<PhoneFrame image={start} alt={t.startAlt} synced={t.synced} sizes="(min-width: 48rem) 14.375rem, 42vw" />
				</div>
			</div>
		) : (
			<div class="container mobile-stage">
				<div class="mobile-desktop" data-rise>
					<WindowFrame scene="hero-conversation" locale={locale} alt={t.desktopAlt} surface="night" sizes="(min-width: 75rem) 56rem, 80vw" />
				</div>
				<div class="mobile-phone" data-parallax="-0.18">
					<PhoneFrame image={approval} alt={t.phoneAlt} synced={t.synced} />
				</div>
			</div>
		)
	}
	<ul class="container mobile-paths">
		{
			t.paths.map((path) => (
				<li data-reveal>
					<span class="mobile-path-icon">
						<Icon name={path.icon as IconName} size="1.375rem" />
					</span>
					<h3>{path.title}</h3>
					<p><Phrases text={path.body} /></p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.mobile {
		overflow: clip;
	}
	.mobile-glow {
		position: absolute;
		right: -20vw;
		top: 30%;
		width: min(90vw, 70rem);
		aspect-ratio: 1;
		background: radial-gradient(closest-side, rgb(10 108 245 / 0.26), transparent 70%);
		pointer-events: none;
	}
	.mobile-stage {
		position: relative;
		margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
		padding-bottom: clamp(2rem, 1rem + 3vw, 4rem);
	}
	.mobile-desktop {
		width: 80%;
	}
	.mobile-phone {
		position: absolute;
		right: 4%;
		bottom: 0;
		width: min(16.75rem, 30%);
	}

	/* Three phones on a shallow podium: the approval in front, the other two a step back and lower,
	 * drifting a little slower than it as the page scrolls. */
	.mobile-trio {
		display: flex;
		justify-content: center;
		align-items: flex-start;
		gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
		margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
	}
	/* The front phone is at most 560px tall (268px wide), the other two 480px. */
	.trio-center {
		position: relative;
		z-index: 1;
		flex: none;
		width: min(16.75rem, 56%);
	}
	.trio-side {
		flex: none;
		width: min(14.375rem, 42%);
		margin-top: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
		opacity: 0.92;
	}

	.mobile-paths {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(1.5rem, 1rem + 2vw, 3rem);
		margin-top: clamp(4rem, 3rem + 4vw, 6.5rem);
	}
	.mobile-paths li {
		padding-top: 1.25rem;
		box-shadow: inset 0 0.5px 0 var(--line-strong);
	}
	.mobile-path-icon {
		display: inline-grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: var(--radius-md);
		background: rgb(255 255 255 / 0.07);
		color: var(--accent);
	}
	.mobile-paths h3 {
		margin-top: 1rem;
		font-size: 1.1875rem;
		font-weight: var(--weight-bold);
	}
	.mobile-paths p {
		margin-top: 0.375rem;
		color: var(--ink-2);
		font-size: 1rem;
	}

	@media (max-width: 48rem) {
		/* On a phone the front one leads and the other two peek in from behind it. */
		.mobile-trio {
			gap: 0;
		}
		.trio-center {
			width: min(16.75rem, 56%);
		}
		.trio-side {
			width: min(14.375rem, 42%);
		}
		.trio-side--left {
			margin-right: -12%;
		}
		.trio-side--right {
			margin-left: -12%;
		}
		.mobile-desktop {
			width: 100%;
		}
		.mobile-phone {
			position: relative;
			right: auto;
			width: 52%;
			margin: -30% 4% 0 auto;
		}
		.mobile-paths {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
