---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import type { Locale } from "../i18n/index.ts";
import { shot, type Scene } from "../lib/shots.ts";

/**
 * A screenshot of Lyra in a macOS window: the corner radius, the hairline edge, the three lights
 * and the shadow, all drawn here — the captures are the window's contents only.
 *
 * Everything is sized in container units against the window's own width, so the lights sit where
 * macOS puts them (16 pt in, 15 pt down, as Lyra's `trafficLightPosition` asks) at any size the
 * picture is drawn at.
 *
 * One <picture> carries both themes. On the page's own surface the dark screenshot is picked by
 * `prefers-color-scheme` — the browser chooses, before any script runs — and `site.ts` rewrites
 * the media queries when the reader has chosen a theme that is not the system's. On a night
 * section it is the dark screenshot, always.
 */
interface Props {
	/** One scene, or several stacked in the same window for a cross-fade (the first sets the size). */
	scene: Scene | Scene[];
	locale: Locale;
	/** One per scene. */
	alt: string | string[];
	/** `night` for the dark sections: the dark screenshot whatever the theme. */
	surface?: "page" | "night";
	/** Above the fold: fetched first and never lazily. */
	priority?: boolean;
	sizes?: string;
	class?: string;
	/** Draw the traffic lights (off for a capture that already has them). */
	lights?: boolean;
	/** The picture inside moves (a zoom, a cross-fade): keep the rounded clip while it does. */
	moving?: boolean;
	[key: `data-${string}`]: string | boolean | undefined;
}

const {
	scene,
	locale,
	alt,
	surface = "page",
	priority = false,
	sizes = "(min-width: 80rem) 75rem, 94vw",
	class: className,
	lights = true,
	moving = false,
	...rest
} = Astro.props;

const WIDTHS = [800, 1280, 1920, 2560];
const DARK = "(prefers-color-scheme: dark)";
const night = surface === "night";
const scenes = Array.isArray(scene) ? scene : [scene];
const alts = Array.isArray(alt) ? alt : [alt];

async function sources(image: ImageMetadata) {
	const [avif, webp] = await Promise.all([
		getImage({ src: image, format: "avif", widths: WIDTHS, quality: 62 }),
		getImage({ src: image, format: "webp", widths: WIDTHS, quality: 80 }),
	]);
	return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute };
}

const pictures = await Promise.all(
	scenes.map(async (name, index) => {
		const light = shot(name, "light", locale);
		const dark = shot(name, "dark", locale);
		const darkSet = await sources(dark.image);
		const lightSet = night ? darkSet : await sources(light.image);
		const image = night ? dark.image : light.image;
		const fallback = await getImage({ src: image, format: "webp", width: 1440, quality: 80 });
		return {
			name,
			alt: alts[index] ?? alts[0] ?? "",
			darkSet,
			lightSet,
			image,
			src: fallback.src,
			placeholder: night ? !dark.real : !(light.real && dark.real),
		};
	}),
);
const placeholder = pictures.some((picture) => picture.placeholder);
---

<figure class:list={["window", className]} data-scene={scenes.join(" ")} data-placeholder={placeholder ? "" : undefined} {...rest}>
	<div class="window-body">
		<div class:list={["window-screen", { "window-screen--moving": moving || scenes.length > 1 }]}>
			{
				pictures.map((picture, index) => (
					<picture class:list={["window-picture", { "window-picture--stacked": index > 0 }]} data-window-picture data-shot={index}>
						{!night && <source type="image/avif" srcset={picture.darkSet.avif} sizes={sizes} media={DARK} data-dark-source />}
						<source type="image/avif" srcset={picture.lightSet.avif} sizes={sizes} />
						{!night && <source type="image/webp" srcset={picture.darkSet.webp} sizes={sizes} media={DARK} data-dark-source />}
						<source type="image/webp" srcset={picture.lightSet.webp} sizes={sizes} />
						<img
							src={picture.src}
							width={picture.image.width}
							height={picture.image.height}
							alt={picture.alt}
							loading={priority && index === 0 ? "eager" : "lazy"}
							decoding="async"
							fetchpriority={priority && index === 0 ? "high" : "auto"}
							draggable="false"
						/>
					</picture>
				))
			}
			<slot />
		</div>
		{
			lights && (
				<span class="window-lights" aria-hidden="true">
					<i />
					<i />
					<i />
				</span>
			)
		}
	</div>
</figure>

<style>
	/* The figure is only the container the units measure; the window is its child. */
	.window {
		container-type: inline-size;
		margin: 0;
	}
	.window-body {
		/* 1 pt of the captured 1440 × 900 pt window, at whatever width it is drawn. */
		--pt: calc(100cqw / 1440);
		position: relative;
		border-radius: max(0.3125rem, calc(12 * var(--pt)));
		box-shadow: var(--shadow-window);
		background: var(--surface);
	}
	/* The edge is drawn over the picture, so a dark window keeps its outline on a black page. */
	.window-body::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 3;
		border-radius: inherit;
		box-shadow:
			inset 0 0 0 0.5px var(--frame-edge),
			inset 0 1px 0 0 var(--frame-highlight);
		pointer-events: none;
	}
	.window-screen {
		position: relative;
		aspect-ratio: 1440 / 900;
		border-radius: inherit;
		overflow: hidden;
	}
	/* Safari drops a rounded clip over a transformed child unless the clip has its own layer. */
	.window-screen--moving {
		transform: translateZ(0);
	}
	.window-picture,
	.window-picture img {
		display: block;
		width: 100%;
		height: 100%;
	}
	/* Later scenes lie on the first, hidden until the motion script brings them forward. */
	.window-picture--stacked {
		position: absolute;
		inset: 0;
		opacity: 0;
	}
	.window-picture img {
		object-fit: cover;
		user-select: none;
		-webkit-user-drag: none;
	}

	/* 12 pt lights, 20 pt apart, their box 16 pt in and 15 pt down — where macOS puts them. */
	.window-lights {
		position: absolute;
		z-index: 4;
		top: calc(16 * var(--pt));
		left: calc(17 * var(--pt));
		display: flex;
		gap: calc(8 * var(--pt));
		pointer-events: none;
	}
	.window-lights i {
		display: block;
		width: calc(12 * var(--pt));
		height: calc(12 * var(--pt));
		border-radius: 50%;
		background: #ff5f57;
		box-shadow: inset 0 0 0 max(0.5px, calc(0.5 * var(--pt))) rgb(0 0 0 / 0.12);
	}
	.window-lights i:nth-child(2) {
		background: #febc2e;
	}
	.window-lights i:nth-child(3) {
		background: #28c840;
	}
</style>
