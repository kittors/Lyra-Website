---
/**
 * A headline cut into pieces that rise one after another out of their own masks.
 *
 * The cutting happens here, at build time, not in the browser: no layout shift when a script
 * rewrites the heading, nothing to undo on resize, and the heading is whole text without scripts.
 * Latin splits at spaces. Chinese has none, so it splits after its punctuation into phrases — a
 * clause rises as a clause, never as a broken word. A clause that ends in a closing mark is
 * marked `closes`, so the stylesheet can give back the mark's blank half where the browser cannot.
 *
 * `text` is one line, or an array for lines that should always break where written.
 */
type Tag = "h1" | "h2" | "h3" | "p" | "span";

interface Props {
	as?: Tag;
	text: string | string[];
	class?: string;
	id?: string;
	/** Rise word by word (the default) or line by line. */
	by?: "word" | "line";
	[key: `data-${string}`]: string | boolean | undefined;
}

const { as: Element = "h2", text, class: className, id, by = "word", ...rest } = Astro.props;
const lines = Array.isArray(text) ? text : [text];

const HAN = /[㐀-鿿]/;
/** Full-width closing marks, whose glyph fills only the left half of its square. */
const CLOSING = /[，。、）」』】》]$/;
function pieces(line: string): { text: string; space: boolean }[] {
	if (HAN.test(line)) {
		return line
			.split(/(?<=[，。、！？：；])/)
			.filter(Boolean)
			.map((part) => ({ text: part, space: false }));
	}
	const words = line.split(/\s+/).filter(Boolean);
	return words.map((word, index) => ({ text: word, space: index < words.length - 1 }));
}
---

<Element class:list={[className, "split"]} id={id} data-split={by} {...rest}>
	{
		lines.map((line) =>
			by === "line" ? (
				<span class="line">
					<span class="line-inner">{line}</span>
				</span>
			) : (
				<span class="split-line">
					{pieces(line).map((piece) => (
						<>
							<span class:list={["word", { closes: CLOSING.test(piece.text) }]}>
								<span class="word-inner">{piece.text}</span>
							</span>
							{piece.space ? " " : null}
						</>
					))}
				</span>
			),
		)
	}
</Element>

<style>
	.split-line {
		display: block;
	}
	/* Padded so descenders and the foot of a Han glyph are not clipped while still; the negative
	 * margin gives the padding back so the line height is the heading's own. */
	.word {
		display: inline-block;
		overflow: clip;
		padding-block: 0.08em 0.14em;
		margin-block: -0.08em -0.14em;
		vertical-align: top;
	}
	.word-inner {
		display: inline-block;
	}
</style>
